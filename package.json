{
  "name": "stamp-grader",
  "version": "0.1.0",
  "description": "Stamp scanning and grading tool: perforation gauge, centering, color and watermark analysis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "stamp-grader": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
